[sub_resource type="Resource" id="Resource_7g0o1"]
script = ExtResource("2_hogg8")
kind = 1
key = &"path_commons"

[sub_resource type="Resource" id="Resource_jy8xa"]
script = ExtResource("2_hogg8")
kind = 12
key = &"medieval"

[sub_resource type="Resource" id="Resource_3obmp"]
script = ExtResource("2_hogg8")
text = "The neighbours took responsibility for their own streets and made room at the table for the towns that came to visit."

[sub_resource type="Resource" id="Resource_ri4c1"]
script = ExtResource("1_gwb1y")
id = &"name_the_commons"
label = "Put the neighbourhoods in charge"
effects = Array[ExtResource("2_hogg8")]([SubResource("Resource_7g0o1"), SubResource("Resource_jy8xa"), SubResource("Resource_3obmp")])

[sub_resource type="Resource" id="Resource_sot1m"]
script = ExtResource("2_hogg8")
kind = 1
key = &"path_circuit"

[sub_resource type="Resource" id="Resource_g1u6m"]
script = ExtResource("2_hogg8")
kind = 12
key = &"medieval"

[sub_resource type="Resource" id="Resource_t8vls"]
script = ExtResource("2_hogg8")
text = "The towns sent people to learn how the others did the work, and each visitor took one good idea back along the road."

[sub_resource type="Resource" id="Resource_xvqwj"]
script = ExtResource("1_gwb1y")
id = &"share_the_circuit"
label = "Have the towns share the work"
effects = Array[ExtResource("2_hogg8")]([SubResource("Resource_sot1m"), SubResource("Resource_g1u6m"), SubResource("Resource_t8vls")])

[resource]
script = ExtResource("4_uup2v")
id = &"what_we_keep_together"
title = "What we keep together"
body = "The neighbouring towns ask how to share the work of looking after their water, books and market days. The channels run and the markets are open. This is a question for the years ahead."
category = &"settlement"
choices = Array[ExtResource("1_gwb1y")]([SubResource("Resource_ri4c1"), SubResource("Resource_xvqwj")])
