key = &"enlightenment"

[sub_resource type="Resource" id="Resource_tbhkt"]
script = ExtResource("2_3t6by")
text = "A fresh sheet went up beside the old one. There was room to try again."

[sub_resource type="Resource" id="Resource_1122c"]
script = ExtResource("1_um6a5")
id = &"repeat_here"
label = "Repeat the observation here"
effects = Array[ExtResource("2_3t6by")]([SubResource("Resource_ssbpa"), SubResource("Resource_wocgi"), SubResource("Resource_tbhkt")])

