[resource]
script = ExtResource("4_7pdy0")
id = &"two_reports_one_question"
title = "Two reports, one question"
body = "The towns' notebooks have come back. Two careful reports disagree. Where should the next observation be made?"
category = &"settlement"
choices = Array[ExtResource("1_um6a5")]([SubResource("Resource_1122c"), SubResource("Resource_ihkim")])
