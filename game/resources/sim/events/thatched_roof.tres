[sub_resource type="Resource" id="Resource_dcypr"]
script = ExtResource("2_5cmhj")
kind = 10
key = &"first_roof"
text = "A Roof of Your Own"

[sub_resource type="Resource" id="Resource_lymam"]
script = ExtResource("2_5cmhj")
text = "{subject} lashed reed bundles over the poles, and that night the rain ran off the roof as if it had never been a problem."

[sub_resource type="Resource" id="Resource_iw7nh"]
script = ExtResource("1_x654y")
id = &"thatch_it"
label = "Bind reeds into a thatch"
effects = Array[ExtResource("2_5cmhj")]([SubResource("Resource_dcypr"), SubResource("Resource_lymam")])

[sub_resource type="Resource" id="Resource_qtefj"]
script = ExtResource("2_5cmhj")
text = "The hides dripped all night, and everyone moved their bedding to the dry side."

[sub_resource type="Resource" id="Resource_sffxm"]
script = ExtResource("1_x654y")
id = &"make_do"
label = "Make do with the hides"
effects = Array[ExtResource("2_5cmhj")]([SubResource("Resource_qtefj")])

