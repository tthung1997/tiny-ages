[resource]
script = ExtResource("4_bxxdn")
id = &"thatched_roof"
title = "Rain through the hides"
body = "{subject} is tired of rain dripping through the hides. Bundles of river reed, bound tight over the poles, might shed it."
requires = Array[ExtResource("3_pbub7")]([SubResource("Resource_8pb16"), SubResource("Resource_p24s4"), SubResource("Resource_y8i0p")])
needs_subject = true
subject_requires = Array[ExtResource("3_pbub7")]([SubResource("Resource_d4enl")])
