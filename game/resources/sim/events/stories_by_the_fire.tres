[resource]
script = ExtResource("4_ippca")
id = &"stories_by_the_fire"
title = "A story by the fire"
body = "{subject} has started telling the others about the day, and for once nobody is eager to sleep."
requires = Array[ExtResource("3_migjb")]([SubResource("Resource_1x1dx"), SubResource("Resource_8resg"), SubResource("Resource_vdjin")])
needs_subject = true
subject_requires = Array[ExtResource("3_migjb")]([SubResource("Resource_4ixx8")])
