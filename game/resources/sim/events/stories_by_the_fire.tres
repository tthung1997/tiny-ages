effects = Array[ExtResource("2_xjmai")]([SubResource("Resource_xcvcr"), SubResource("Resource_knoha")])

[sub_resource type="Resource" id="Resource_q3sdm"]
script = ExtResource("2_xjmai")
text = "The fire burned down and everyone drifted to sleep."

