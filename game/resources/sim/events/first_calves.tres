[resource]
script = ExtResource("4_m4yjb")
id = &"first_calves"
title = "Calves in the spring"
body = "The herd that winters by the camp has calves this spring: small, unsteady things, and their mothers watch the camp with suspicion."
category = &"nature"
requires = Array[ExtResource("3_seq73")]([SubResource("Resource_13y6p"), SubResource("Resource_w3ieq"), SubResource("Resource_eeq5o"), SubResource("Resource_7ow5t")])
