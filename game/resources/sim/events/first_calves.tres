key = &"first_harvest"
text = "The First Calves"

[sub_resource type="Resource" id="Resource_t0euh"]
script = ExtResource("2_6gf46")
text = "The group kept watch through the long nights of calving. By midsummer there was milk, and nobody had lost an animal."

[sub_resource type="Resource" id="Resource_qjbgb"]
script = ExtResource("1_uig7i")
id = &"tend_the_calves"
label = "Keep them close and tend the herd"
effects = Array[ExtResource("2_6gf46")]([SubResource("Resource_q4b7p"), SubResource("Resource_7qde8"), SubResource("Resource_t0euh")])

[sub_resource type="Resource" id="Resource_kxq0a"]
script = ExtResource("2_6gf46")
text = "The herd kept to itself, and the calves were hardly seen again that spring."

[sub_resource type="Resource" id="Resource_j25dj"]
script = ExtResource("1_uig7i")
id = &"let_them_roam"
label = "Let the herd keep to itself"
effects = Array[ExtResource("2_6gf46")]([SubResource("Resource_kxq0a")])

