[resource]
script = ExtResource("4_xu48c")
id = &"room_on_the_page"
title = "Room on the page"
body = "The towns have been sending one another pages by hand. The makers have found a way to make many copies from one setting. What shall the first sheets carry?"
category = &"settlement"
choices = Array[ExtResource("1_32ve6")]([SubResource("Resource_ulkqi"), SubResource("Resource_l8ble")])
